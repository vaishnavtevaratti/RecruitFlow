# Optional overrides for the Playwright E2E suite. Copy to testing/.env.e2e (git-ignored).
# MySQL host/user/password are read from server/.env; only the database name differs.

# Isolated test database. Must end in _e2e or _test and differ from server DB_NAME.
E2E_DB_NAME=recruitflow_e2e

# Ports for the test API and test frontend (separate from dev 5000/5173)
E2E_API_PORT=5100
E2E_WEB_PORT=5174

# HR test account created in the test database on every run
E2E_HR_EMAIL=e2e.hr@recruitflow.test
# Leave empty to generate a random password per run (recommended)
E2E_HR_PASSWORD=
# Password for candidate accounts the tests register; empty = random per run
E2E_CANDIDATE_PASSWORD=

# 1 = keep this run's test records in the E2E database for inspection
E2E_KEEP=0
