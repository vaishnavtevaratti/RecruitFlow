VITE_API_URL=http://localhost:5000/api
# Production: set to your deployed API before building, e.g. https://api.example.com/api
# Show demo-login buttons in a production build (always shown in npm run dev)
VITE_SHOW_DEMO_LOGIN=false
# Time zone interview times are shown in (must match the server's APP_TIMEZONE)
VITE_APP_TIMEZONE=Asia/Kolkata
