PORT=5000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=YOUR_MYSQL_PASSWORD
DB_NAME=recruitflow
DB_SSL=false
# With DB_SSL=true the server certificate is always verified. For providers with their own CA
# (e.g. Aiven) set DB_SSL_CA to the CA certificate: a path to the .pem file, or the PEM text itself.
DB_SSL_CA=
JWT_SECRET=YOUR_LOCAL_JWT_SECRET
DEMO_HR_EMAIL=hr@recruitflow.com
DEMO_HR_PASSWORD=Admin@123

# Comma-separated list of allowed browser origins (e.g. http://localhost:5173).
# Leave empty to allow all origins locally; always set it in production.
CORS_ORIGIN=

# Production settings (see README "Production Deployment")
NODE_ENV=development
# Set to 1 behind a reverse proxy / PaaS so rate limiting sees real client IPs
TRUST_PROXY=
# Failed sign-in/sign-up attempts allowed per IP per 15 minutes
AUTH_RATE_LIMIT_MAX=10
# false = db:setup skips demo seed data (use false in production)
SEED_DEMO_DATA=true
# Business time zone: interview times are entered and shown in it, stored in UTC
APP_TIMEZONE=Asia/Kolkata
